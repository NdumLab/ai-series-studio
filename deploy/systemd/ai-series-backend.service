[Unit]
Description=AI Series Studio backend API
After=network-online.target ai-series-mongo.service
Wants=network-online.target
Requires=ai-series-mongo.service

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/ai-series-studio/backend
Environment=PYTHONUNBUFFERED=1
Environment=CORS_ORIGINS=*
Environment=ASSET_PUBLIC_BASE_URL=http://34.229.51.36:8000/assets
ExecStart=/bin/bash -lc 'exec /home/ec2-user/ai-series-studio/backend/.venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8000'
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
